# Copy to .env for local development. Set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# Your MongoDB cluster connection string (required)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/

# Database name (optional — uses the URI's default when omitted)
MONGODB_DB=portfolio

# Secret for signing admin session cookies (required, any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Canonical site URL — used for SEO (canonical tags, sitemap, robots, JSON-LD).
# Defaults to https://maloz-dev.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://maloz-dev.vercel.app
